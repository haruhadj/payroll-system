# Copy to .env and fill in your values: cp .env.example .env

# Postgres connection string (required).
# Cloud DBs like Supabase/Neon work out of the box (the app forces sslmode=require).
# Local example: postgresql://localhost:5432/payroll
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME

# Base URL of the app. Local dev uses http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Resend API key — only used for password-reset emails.
# Optional for testing: sign-in and payroll work without a valid key.
RESEND_API_KEY=
